+/* the cache's size, after it changed, into the index file (on the Switch,
+whose index is not a shared mapping of the file) */
+static void
+index_size_written(struct disk_cache *cache)
+{
+#ifdef __SWITCH__
+   uint64_t size = *cache->size;
+
+   if (lseek(cache->index_fd, 0, SEEK_SET) == 0)
+      write(cache->index_fd, &size, sizeof(size));
+#else
+   (void)cache;
+#endif
+}
+
 void
 disk_cache_destroy(struct disk_cache *cache)
 {
    if (cache && !cache->path_init_failed) {
+#ifdef __SWITCH__
+      close(cache->index_fd);
+#else
       util_queue_finish(&cache->cache_queue);
       util_queue_destroy(&cache->cache_queue);
       munmap(cache->index_mmap, cache->index_mmap_size);
+#endif
    }
 
    ralloc_free(cache);
