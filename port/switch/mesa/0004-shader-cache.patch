+/* the cache's size, after it changed, into the index file (on the Switch,
+whose index is not a shared mapping of the file) */
+static void
+index_size_written(struct disk_cache *cache)
+{
+#ifdef __SWITCH__
+   uint64_t size = *cache->size;
+
+   if (lseek(cache->index_fd, 0, SEEK_SET) == 0)
+      write(cache->index_fd, &size, sizeof(size));
+#else
+   (void)cache;
+#endif
+}
+
