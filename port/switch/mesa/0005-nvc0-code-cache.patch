+#ifdef __SWITCH__
+/* For nvc0's code cache (nvc0_program.c): the sizes of a program's
+ * relocation and fixup records, and its fixups' functions as indices into
+ * this emitter's (the Switch's GM20B is a GM107-family GPU), which a file can
+ * hold, and back. A fixup of another function cannot be stored.
+ */
+static const nv50_ir::FixupApply gm107_fixup_functions[] = {
+   nv50_ir::interpApply,
+   nv50_ir::selpFlip,
+};
+
+extern "C" size_t
+nv50_ir_switch_relocs_size(const void *data)
+{
+   const nv50_ir::RelocInfo *info = (const nv50_ir::RelocInfo *)data;
+
+   return info ? sizeof(*info) + info->count * sizeof(info->entry[0]) : 0;
+}
+
+extern "C" size_t
+nv50_ir_switch_fixups_size(const void *data)
+{
+   const nv50_ir::FixupInfo *info = (const nv50_ir::FixupInfo *)data;
+
+   return info ? sizeof(*info) + info->count * sizeof(info->entry[0]) : 0;
+}
+
+extern "C" bool
+nv50_ir_switch_fixups_store(void *data)
+{
+   nv50_ir::FixupInfo *info = (nv50_ir::FixupInfo *)data;
+
+   for (uint32_t i = 0; info && i < info->count; i++) {
+      uintptr_t index;
+
+      for (index = 0; index < ARRAY_SIZE(gm107_fixup_functions); index++)
+         if (info->entry[i].apply == gm107_fixup_functions[index])
+            break;
+      if (index == ARRAY_SIZE(gm107_fixup_functions))
+         return false;
+      info->entry[i].apply = (nv50_ir::FixupApply)index;
+   }
+   return true;
+}
+
+extern "C" bool
+nv50_ir_switch_fixups_load(void *data)
+{
+   nv50_ir::FixupInfo *info = (nv50_ir::FixupInfo *)data;
+
+   for (uint32_t i = 0; info && i < info->count; i++) {
+      uintptr_t index = (uintptr_t)info->entry[i].apply;
+
+      if (index >= ARRAY_SIZE(gm107_fixup_functions))
+         return false;
+      info->entry[i].apply = gm107_fixup_functions[index];
+   }
+   return true;
+}
+#endif
