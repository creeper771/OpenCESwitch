+#ifdef __SWITCH__
+/* libnx's (switch/kernel/svc.h, not included here) */
+uint32_t svcSetThreadCoreMask(uint32_t handle, int32_t preferred_core, uint32_t affinity_mask);
+uint32_t svcSetThreadPriority(uint32_t handle, uint32_t priority);
+#define SWITCH_CURRENT_THREAD 0xFFFF8000u
+#endif
+
 static void
 glthread_thread_initialization(void *job, int thread_index)
 {
    struct gl_context *ctx = (struct gl_context*)job;
 
+#ifdef __SWITCH__
+   /* Mesa's threads start on core 2 below the application (u_thread.h):
+    * the GL thread runs beside the application's thread instead, on core
+    * mesa_glthread_core (default 1), at the usual priority, above the
+    * application's time-sliced others, as it keeps the frame going */
+   {
+      const char *core = getenv("mesa_glthread_core");
+      int32_t number = core ? atoi(core) : 1;
+
+      if (number >= 0 && number <= 2)
+         svcSetThreadCoreMask(SWITCH_CURRENT_THREAD, number, 1u << number);
+      svcSetThreadPriority(SWITCH_CURRENT_THREAD, 0x2c);
+   }
+#endif
    ctx->Driver.SetBackgroundContext(ctx, &ctx->GLThread.stats);
    _glapi_set_context(ctx);
 }
