+#ifdef __SWITCH__
+/* Entries are written by a thread of the cache's (on core 2, below the
+ * application's threads, as Mesa's threads start: u_thread.h), so that a
+ * program's first link does not also wait for the SD card: the writes were
+ * 14% of the frames that stuttered as new programs were linked. The host
+ * waits for the queue before the process's services close
+ * (disk_cache_switch_finish), which a thread still writing had broken.
+ */
+struct switch_put {
+   struct switch_put *next;
+   struct disk_cache_put_job *job;
+};
+
+static struct {
+   once_flag once;
+   mtx_t lock;
+   cnd_t work, idle;
+   struct switch_put *head, *tail;
+   bool started, busy;
+   thrd_t thread;
+} switch_put_queue = { ONCE_FLAG_INIT };
+
+static int
+switch_put_writer(void *unused)
+{
+   (void)unused;
+   for (;;) {
+      struct switch_put *put;
+
+      mtx_lock(&switch_put_queue.lock);
+      while (!switch_put_queue.head)
+         cnd_wait(&switch_put_queue.work, &switch_put_queue.lock);
+      put = switch_put_queue.head;
+      switch_put_queue.head = put->next;
+      if (!switch_put_queue.head)
+         switch_put_queue.tail = NULL;
+      switch_put_queue.busy = true;
+      mtx_unlock(&switch_put_queue.lock);
+
+      cache_put(put->job, 0);
+      destroy_put_job(put->job, 0);
+      free(put);
+
+      mtx_lock(&switch_put_queue.lock);
+      switch_put_queue.busy = false;
+      if (!switch_put_queue.head)
+         cnd_broadcast(&switch_put_queue.idle);
+      mtx_unlock(&switch_put_queue.lock);
+   }
+   return 0;
+}
+
+static void
+switch_put_queue_start(void)
+{
+   mtx_init(&switch_put_queue.lock, mtx_plain);
+   cnd_init(&switch_put_queue.work);
+   cnd_init(&switch_put_queue.idle);
+   switch_put_queue.started =
+      thrd_create(&switch_put_queue.thread, switch_put_writer, NULL) ==
+         thrd_success;
+}
+
+static void
+switch_put_queue_add(struct disk_cache_put_job *job)
+{
+   struct switch_put *put;
+
+   call_once(&switch_put_queue.once, switch_put_queue_start);
+   put = switch_put_queue.started ? malloc(sizeof(*put)) : NULL;
+   if (!put) {
+      /* (no thread: written here) */
+      cache_put(job, 0);
+      destroy_put_job(job, 0);
+      return;
+   }
+   put->next = NULL;
+   put->job = job;
+   mtx_lock(&switch_put_queue.lock);
+   if (switch_put_queue.tail)
+      switch_put_queue.tail->next = put;
+   else
+      switch_put_queue.head = put;
+   switch_put_queue.tail = put;
+   cnd_signal(&switch_put_queue.work);
+   mtx_unlock(&switch_put_queue.lock);
+}
+
+/* returns once every entry queued is written, or after two seconds (the
+ * host's shutdown) */
+void
+disk_cache_switch_finish(void)
+{
+   struct timespec until;
+
+   if (!switch_put_queue.started)
+      return;
+   clock_gettime(CLOCK_REALTIME, &until);
+   until.tv_sec += 2;
+   mtx_lock(&switch_put_queue.lock);
+   while (switch_put_queue.head || switch_put_queue.busy) {
+      if (cnd_timedwait(&switch_put_queue.idle, &switch_put_queue.lock,
+                        &until) == thrd_timedout)
+         break;
+   }
+   mtx_unlock(&switch_put_queue.lock);
+}
+#endif
